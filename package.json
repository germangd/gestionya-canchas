{
  "name": "gestionya-canchas",
  "version": "1.0.0",
  "private": true,
  "description": "Alquiler de canchas para la secretaría del club. Funciona sin internet y guarda los datos en la PC.",
  "main": "electron/main.js",
  "licenseApiBase": "https://gestionya.taildbd7e3.ts.net/v1",
  "scripts": {
    "start": "electron .",
    "start-demo": "set APP_EDITION=demo&& electron .",
    "test": "node --test test/store.test.js test/demoLicense.test.js",
    "preview": "node preview-server.js",
    "build-win": "electron-builder --win nsis",
    "build-win-portable": "electron-builder --win portable -c.artifactName=GestionYa-Canchas-${version}-portable-${arch}.${ext}",
    "build-win-demo": "electron-builder --win nsis -c.appId=com.gestionya.canchas.demo -c.extraMetadata.edition=demo -c.extraMetadata.demoEdition=true -c.extraMetadata.demoDays=7 -c.productName=\"GestionYa Canchas Demo\" -c.nsis.shortcutName=\"GestionYa Canchas Demo\" -c.artifactName=GestionYa-Canchas-Demo-${version}-${arch}.${ext}",
    "build-win-demo-portable": "electron-builder --win portable -c.appId=com.gestionya.canchas.demo -c.extraMetadata.edition=demo -c.extraMetadata.demoEdition=true -c.extraMetadata.demoDays=7 -c.productName=\"GestionYa Canchas Demo\" -c.artifactName=GestionYa-Canchas-Demo-${version}-portable-${arch}.${ext}"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.11.0"
  },
  "build": {
    "appId": "com.gestionya.canchas",
    "productName": "GestionYa Canchas",
    "artifactName": "GestionYa-Canchas-Setup-${version}.${ext}",
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icono-canchas.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GestionYa Canchas"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true
  }
}
